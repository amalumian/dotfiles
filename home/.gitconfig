[user]
  name = Arthur Malumian
  email = arthurmalumian@gmail.com
  signingkey = KEYID
[core]
  editor = nvim
  excludesfile = ~/.gitconfig.core.excludesfile
  autocrlf = input
  safecrlf = warn
  pager = delta
[interactive]
  diffFilter = delta --color-only
[include]
	path = ~/.gitconfig.delta.features
[delta]
  navigate = true
  line-numbers = true
  side-by-side = false
  features = catppuccin-mocha
[init]
  defaultBranch = main
[commit]
  gpgsign = true
[merge]
  tool = nvimdiff
  conflictstyle = zdiff3
[diff]
  tool = nvimdiff
[difftool]
  prompt = false
