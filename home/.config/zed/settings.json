{
  "languages": {
    "JavaScript": {
      "inlay_hints": {
        "enabled": false,
      },
      "format_on_save": "on",
      "formatter": [
        {
          "code_action": "source.fixAll.eslint",
        },
        {
          "external": {
            "command": "prettier",
            "arguments": ["--stdin-filepath", "{buffer_path}"],
          },
        },
      ],
    },
    "TypeScript": {
      "inlay_hints": {
        "enabled": false,
      },
      "format_on_save": "on",
      "formatter": [
        {
          "code_action": "source.fixAll.eslint",
        },
        {
          "external": {
            "command": "prettier",
            "arguments": ["--stdin-filepath", "{buffer_path}"],
          },
        },
      ],
    },
    "TSX": {
      "inlay_hints": {
        "enabled": false,
      },
      "format_on_save": "on",
      "formatter": [
        {
          "code_action": "source.fixAll.eslint",
        },
        {
          "external": {
            "command": "prettier",
            "arguments": ["--stdin-filepath", "{buffer_path}"],
          },
        },
      ],
    },
  },
  "base_keymap": "VSCode",
  "autosave": "off",
  "use_autoclose": false,
  "vim_mode": true,
  "vim": {
    "toggle_relative_line_numbers": true,
    "cursor_shape": {
      "insert": "block",
      "normal": "block",
      "replace": "block",
      "visual": "block",
    },
  },
  "ui_font_family": "Berkeley Mono",
  "ui_font_size": 18,
  "buffer_font_family": "Berkeley Mono",
  "buffer_font_size": 18,
  "agent_ui_font_size": 18,
  "agent_buffer_font_size": 16,
  "terminal": {
    "font_family": "BerkeleyMono Nerd Font Mono",
    "font_size": 16,
    "option_as_meta": true,
    "shell": {
      "with_arguments": {
        "program": "zsh",
        "args": ["--no-rcs"],
      },
    },
  },
  "relative_line_numbers": "enabled",
  "cursor_blink": true,
  "cursor_shape": "block",
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha",
  },
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha",
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
      "max_severity": "all",
    },
  },
  "tab_bar": {
    "show": false,
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false,
  },
  "diff_view_style": "unified",
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "auto_install_extensions": {
    "astro": true,
    "basher": true,
    "catppuccin-icons": true,
    "catppuccin": true,
    "css-modules-kit": true,
    "css-variables": true,
    "dockerfile": true,
    "emmet": true,
    "git-firefly": true,
    "html": true,
    "latex": true,
    "lua": true,
    "make": true,
    "react-typescript-snippets": true,
    "sql": true,
    "toml": true,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry",
    },
    "opencode": {
      "type": "registry",
    },
  },
  "edit_predictions": {
    "provider": "zed",
  },
  "agent": {
    "dock": "right",
    "inline_assistant_model": {
      "provider": "zed.dev",
      "model": "claude-opus-4-6",
    },
  },
}
